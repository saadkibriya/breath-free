<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ribbon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pixel_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Days block in Mint -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ribbon_text_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="15"
            android:textColor="#00E599"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ribbon_label_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="DAYS"
            android:textColor="#A7F3D0"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dot separator -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="•"
        android:textColor="#523963"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Hours block in Pink -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ribbon_text_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="8"
            android:textColor="#FF7597"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ribbon_label_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="HOURS"
            android:textColor="#FFC2D1"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Right Badge: Milestone Status & Smoke Window -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ribbon_text_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:letterSpacing="0.05"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="NICOTINE FREE"
            android:textColor="#00E599"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ribbon_text_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$184.00 Saved"
            android:textColor="#F7C948"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ribbon_text_window"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Window: Ready"
            android:textColor="#FF7597"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
