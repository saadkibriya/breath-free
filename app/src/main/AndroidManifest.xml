<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Large Journey AppWidget -->
        <receiver
            android:name=".widget.SmokeFreeWidgetProvider"
            android:exported="true"
            android:label="BreatheFree Journey (Large)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smoke_free_widget_info" />
        </receiver>

        <!-- Compact AppWidget -->
        <receiver
            android:name=".widget.SmokeFreeCompactWidgetProvider"
            android:exported="true"
            android:label="BreatheFree Daily (Compact)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smoke_free_widget_compact_info" />
        </receiver>

        <!-- 4x1 Bold Milestone Ribbon AppWidget -->
        <receiver
            android:name=".widget.SmokeFreeMilestoneWidgetProvider"
            android:exported="true"
            android:label="BreatheFree Milestone (4x1 Bold)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smoke_free_widget_ribbon_info" />
        </receiver>

        <!-- Smoke Window Alarm Receiver -->
        <receiver
            android:name=".service.SmokeWindowReceiver"
            android:exported="false" />

    </application>

</manifest>
